# Copy to .env on the server and replace every blank value with unique values.
# Generate secrets in a password manager or with: openssl rand -base64 48
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# PostgreSQL is provisioned for the later migration; current runtime still uses JSON.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Use a unique immutable label for every reviewed application release.
APP_IMAGE_TAG=current

# Compiled into the client bundle at image build time; optional if not configured.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Bootstrap serves ACME HTTP challenge only until an IP TLS certificate is issued.
NGINX_CONF=./deploy/nginx/bootstrap.conf
NGINX_BIND_ADDRESS=0.0.0.0
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
PUBLIC_IP=
ACME_EMAIL=
